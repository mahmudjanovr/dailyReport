# Dependencies
node_modules/
package-lock.json

# Environment variables & secrets
.env
.env.*
.env.local
.env.*.local
!.env.example

# SQLite Databases & Storage
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
storage/data/*.sqlite
storage/data/*.sqlite-wal
storage/data/*.sqlite-shm
storage/data/*.db
!storage/data/.gitkeep

# Generated Reports & PDFs
*.pdf
storage/reports/*.pdf
!storage/reports/.gitkeep

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary & cache
tmp/
temp/
scratch/
.cache/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini

# Test coverage
coverage/
.nyc_output/
